# ─────────────────────────────────────────
# Configuration de l'agent WhatsApp IA
# Copie ce fichier en .env et remplis les valeurs
# NE JAMAIS committer le fichier .env sur Git !
# ─────────────────────────────────────────

# Clé API Anthropic (Claude)
# Obtenir sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business API (Meta)
# Obtenir sur : https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=mon_token_secret_123

# Serveur
PORT=3000
